# ============================================================================
# Django core
# ============================================================================

DEBUG=False

# Logging: blank follows DEBUG (compact text in development, JSON in production).
# Explicit formats: text, text_verbose (full metadata), json.
LOG_FORMAT=
# Blank level follows DEBUG: DEBUG locally, INFO in production. Explicit value wins.
LOG_LEVEL=
LOG_ENVIRONMENT=
# Docker Compose sets LOG_SERVICE per process; default outside Docker: eazyclass.

# Django secret key (used for cryptographic signing)
SECRET_KEY=change-me-in-production

ALLOWED_HOSTS=eazyclass.ru,www.eazyclass.ru
CSRF_TRUSTED_ORIGINS=https://eazyclass.ru,https://www.eazyclass.ru

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# ============================================================================
# PostgreSQL database
# ============================================================================

POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=pgdb
POSTGRES_PORT=5432


# ============================================================================
# Redis
# ============================================================================

REDIS_PORT=6379

# Redis logical databases
REDIS_DEFAULT_CACHE_URL=redis://redis:6379/1
REDIS_AUTH_CACHE_URL=redis://redis:6379/2
REDIS_SCRAPY_URL=redis://redis:6379/3

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0


# ============================================================================
# Authentication / JWT / HMAC
# ============================================================================

JWT_SIGNING_KEY=change-me

TELEGRAM_HMAC_SECRET=change-me
VK_HMAC_SECRET=change-me


# ============================================================================
# Scraping / external data sources
# ============================================================================

BASE_SCRAPING_URL=https://example.ru/rasp/


# ============================================================================
# Telegram bot
# ============================================================================

TELEGRAM_BOT_TOKEN=change-me
TELEGRAM_BOT_USERNAME=your_bot_username


# ============================================================================
# Flower (Celery monitoring)
# ============================================================================

FLOWER_USERNAME=admin
FLOWER_PASSWORD=change-me


# TableParser — Django settings (inside Docker containers).
# Main and dev Compose files install the package and mount resources automatically.
TABLEPARSER_RESOURCE_ROOT=/opt/tableparser-release/runtime
# Historical knowledge namespace, NOT an API endpoint to fetch catalogs from.
TABLEPARSER_CATALOG_SOURCE=https://eazyclass.ru/api/v1
# Local: http://127.0.0.1:8000; production: your public application URL.
TABLEPARSER_PUBLIC_BASE_URL=https://eazyclass.ru

# TableParser — Docker settings (host path containing image/, runtime/, seed/, release.json).
# Local Windows: C:/Users/lenovo/Desktop/EazyClassProject/tableparser-releases/0.1.1
TABLEPARSER_RELEASE_DIR=/srv/tableparser/releases/0.1.1
# Image tags are not needed for normal `docker compose up -d --build`.
